DEFINE VAR G = UNION(ROW("g","m","s",dt"2026-10-01","e",dt"2026-11-01"), SELECTCOLUMNS(CALENDAR(dt"2026-10-01",dt"2026-10-30"),"g",FORMAT([Date],"yyyy-mm-dd"),"s",[Date],"e",[Date]+1), SELECTCOLUMNS(CALENDAR(dt"2026-10-02",dt"2026-10-30"),"g","c"&FORMAT(DAY([Date])-1,"0"),"s",dt"2026-10-01","e",[Date]))
EVALUATE SELECTCOLUMNS(GENERATE(G, VAR s=[s] VAR e=[e] RETURN CALCULATETABLE(ADDCOLUMNS(SUMMARIZE('WS_BIReport TpBetRecordSummaryDailyMonthly_Output','WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[SiteId],'WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[CurrencyId],'WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[Product]), "wl", CALCULATE(SUM('WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[WinLossSummary])), "vb", CALCULATE(SUM('WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[ValidBetSummary])), "p", CALCULATE(DISTINCTCOUNT('WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[CustId]))), 'WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[TableType]="Daily", 'WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[ReportDate]>=s, 'WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[ReportDate]<e)), "g",[g], "k0",'WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[SiteId], "k1",'WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[CurrencyId], "k2",'WS_BIReport TpBetRecordSummaryDailyMonthly_Output'[Product], "wl",[wl],"vb",[vb],"p",[p])
