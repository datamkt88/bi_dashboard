DEFINE VAR M = UNION(DATATABLE("ym",STRING,"s",DATETIME,"e",DATETIME,{{"2026-09",dt"2026-09-01",dt"2026-10-01"},{"2026-10",dt"2026-10-01",dt"2026-11-01"}}), SELECTCOLUMNS(CALENDAR(dt"2026-10-01",dt"2026-10-27"),"ym",FORMAT([Date],"yyyy-mm-dd"),"s",[Date],"e",[Date]+1))
EVALUATE SELECTCOLUMNS(GENERATE(M, VAR s=[s] VAR e=[e] RETURN CALCULATETABLE(ADDCOLUMNS(SUMMARIZE('WS_BIReport FullSummaryDailyMonthly_Output','WS_Customer customer'[SiteName],'WS_Customer customer'[Currency],'WS_Customer customer'[CurrencyId]), "NRU", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[NRU_Flag])), "FDU", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[FDU_Flag])), "Act", CALCULATE(DISTINCTCOUNT('WS_BIReport FullSummaryDailyMonthly_Output'[CustId]), 'WS_BIReport FullSummaryDailyMonthly_Output'[ActiveUser_Flag]=1), "Ret", CALCULATE(DISTINCTCOUNT('WS_BIReport FullSummaryDailyMonthly_Output'[CustId]), 'WS_BIReport FullSummaryDailyMonthly_Output'[IsMonthlyReturningActiveUser_Flag]=1), "Depr", CALCULATE(DISTINCTCOUNT('WS_BIReport FullSummaryDailyMonthly_Output'[CustId]), 'WS_BIReport FullSummaryDailyMonthly_Output'[Depositor_Flag]=1), "RD", CALCULATE(DISTINCTCOUNT('WS_BIReport FullSummaryDailyMonthly_Output'[CustId]), 'WS_BIReport FullSummaryDailyMonthly_Output'[FDUMonthly_Multi_Redeposit_Flag]=1), "Tx", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[TpTrnsCnt])), "D", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[DepositAmount])), "FD", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[FirstDepositAmt])), "W", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[WithdrawalAmount])), "DF", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[DepositFee])), "WF", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[WithdrawalChargeFee])), "CM", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[CommissionAmt])), "VB", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[ValidBet])), "SB", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[SportsValidBet])), "CB", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[CasinoValidBet])), "LB", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[LiveCasinoValidBet])), "WL", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[WinLostAmount])), "BO", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[BonusAmount])), "RB", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[RebateAmount])), "PRO", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[PrizeAmount])+SUM('WS_BIReport FullSummaryDailyMonthly_Output'[OthRewardAmount])+SUM('WS_BIReport FullSummaryDailyMonthly_Output'[ReferralAmount])), "ADJ", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[AdjustmentAmount]))), 'WS_BIReport FullSummaryDailyMonthly_Output'[ReportDate]>=s, 'WS_BIReport FullSummaryDailyMonthly_Output'[ReportDate]<e, TREATAS({"Nova88","Goal123","Bwing"}, 'WS_Customer customer'[SiteName]))), "m",[ym],"Si",'WS_Customer customer'[SiteName],"Cu",'WS_Customer customer'[Currency],"Ci",'WS_Customer customer'[CurrencyId], "NRU", [NRU], "FDU", [FDU], "Act", [Act], "Ret", [Ret], "Depr", [Depr], "RD", [RD], "Tx", [Tx], "D", [D], "FD", [FD], "W", [W], "DF", [DF], "WF", [WF], "CM", [CM], "VB", [VB], "SB", [SB], "CB", [CB], "LB", [LB], "WL", [WL], "BO", [BO], "RB", [RB], "PRO", [PRO], "ADJ", [ADJ], "pad",REPT("x",400))
