EVALUATE CALCULATETABLE(SELECTCOLUMNS(view_CustomerProfile, "c",view_CustomerProfile[CustId], "mg",view_CustomerProfile[MarketingGroup], "mc",view_CustomerProfile[MarketingChannel], "ac",view_CustomerProfile[AffCode], "an",view_CustomerProfile[AffiliateName], "pad",REPT("x",400)), view_CustomerProfile[CustId] IN {{IDS}})
