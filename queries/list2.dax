EVALUATE SELECTCOLUMNS(FILTER(view_CustomerProfile, view_CustomerProfile[CustId]>1750000 && view_CustomerProfile[SiteName] IN {"Nova88","Goal123","Bwing"} && (view_CustomerProfile[RegTime_utc8]>=dt"2026-07-01" || view_CustomerProfile[LastBettingDate_utc8]>=dt"2026-07-31" || view_CustomerProfile[LastDepositDate_utc8]>=dt"2026-07-31")), "c",view_CustomerProfile[CustId], "sb",view_CustomerProfile[Saba_Id], "si",view_CustomerProfile[SiteName], "cu",view_CustomerProfile[CurrencyId], "rg",view_CustomerProfile[RegTime_utc8], "fd",view_CustomerProfile[FirstDepositDate_utc8], "lb",view_CustomerProfile[LastBettingDate_utc8], "ld",view_CustomerProfile[LastDepositDate_utc8], "v",view_CustomerProfile[VipLevel], "st",view_CustomerProfile[StatusName], "dc",view_CustomerProfile[LT_DepositCnt], "t",view_CustomerProfile[IsTest], "vb",view_CustomerProfile[LT_EffectiveBet], "wl",view_CustomerProfile[LT_WinLoss], "dp",view_CustomerProfile[LT_Deposit], "nd",view_CustomerProfile[LT_NetDeposit])
