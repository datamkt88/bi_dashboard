DEFINE VAR M = SELECTCOLUMNS(CALENDAR(dt"2026-07-01",dt"2026-10-27"),"k",FORMAT([Date],"yyyy-mm-dd"),"s",[Date],"e",[Date]+1)
EVALUATE SELECTCOLUMNS(GENERATE(M, VAR s=[s] VAR e=[e] RETURN CALCULATETABLE(ADDCOLUMNS(SUMMARIZE(view_CustomerProfile,view_CustomerProfile[SiteName],view_CustomerProfile[CurrencyId],view_CustomerProfile[VipLevel]),"fdu",CALCULATE(COUNTROWS(view_CustomerProfile)),"new",CALCULATE(COUNTROWS(view_CustomerProfile),view_CustomerProfile[RegTime_utc8]>=s),"one",CALCULATE(COUNTROWS(view_CustomerProfile),view_CustomerProfile[LT_DepositCnt]<=1),"dep",CALCULATE(SUM(view_CustomerProfile[LT_Deposit])),"nd",CALCULATE(SUM(view_CustomerProfile[LT_NetDeposit])),"wl",CALCULATE(SUM(view_CustomerProfile[LT_WinLoss])),"bo",CALCULATE(SUM(view_CustomerProfile[LT_Bonus])),"vb",CALCULATE(SUM(view_CustomerProfile[LT_EffectiveBet]))), view_CustomerProfile[FirstDepositDate_utc8]>=s, view_CustomerProfile[FirstDepositDate_utc8]<e, TREATAS({"Nova88","Goal123","Bwing"},view_CustomerProfile[SiteName]))), "k",[k],"si",view_CustomerProfile[SiteName],"cu",view_CustomerProfile[CurrencyId],"v",view_CustomerProfile[VipLevel],"fdu",[fdu],"new",[new],"one",[one],"dep",[dep],"nd",[nd],"wl",[wl],"bo",[bo],"vb",[vb])
