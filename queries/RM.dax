DEFINE VAR M = DATATABLE("k",STRING,"s",DATETIME,"e",DATETIME,{{"2025-09",dt"2025-09-01",dt"2025-10-01"},{"2025-10",dt"2025-10-01",dt"2025-11-01"},{"2025-11",dt"2025-11-01",dt"2025-12-01"},{"2025-12",dt"2025-12-01",dt"2026-01-01"},{"2026-01",dt"2026-01-01",dt"2026-02-01"},{"2026-02",dt"2026-02-01",dt"2026-03-01"},{"2026-03",dt"2026-03-01",dt"2026-04-01"},{"2026-04",dt"2026-04-01",dt"2026-05-01"},{"2026-05",dt"2026-05-01",dt"2026-06-01"},{"2026-06",dt"2026-06-01",dt"2026-07-01"},{"2026-07",dt"2026-07-01",dt"2026-08-01"},{"2026-08",dt"2026-08-01",dt"2026-09-01"},{"2026-09",dt"2026-09-01",dt"2026-10-01"},{"2026-10",dt"2026-10-01",dt"2026-11-01"}})
EVALUATE SELECTCOLUMNS(GENERATE(M, VAR s=[s] VAR e=[e] RETURN CALCULATETABLE(ADDCOLUMNS(SUMMARIZE(view_CustomerProfile,view_CustomerProfile[SiteName],view_CustomerProfile[CurrencyId],view_CustomerProfile[VipLevel]),"nru",CALCULATE(COUNTROWS(view_CustomerProfile)),"fdu",CALCULATE(COUNTROWS(view_CustomerProfile),NOT ISBLANK(view_CustomerProfile[FirstDepositDate_utc8])),"fd7",CALCULATE(COUNTROWS(FILTER(view_CustomerProfile,NOT ISBLANK(view_CustomerProfile[FirstDepositDate_utc8]) && view_CustomerProfile[FirstDepositDate_utc8]<view_CustomerProfile[RegTime_utc8]+7))),"dep",CALCULATE(SUM(view_CustomerProfile[LT_Deposit])),"nd",CALCULATE(SUM(view_CustomerProfile[LT_NetDeposit])),"wl",CALCULATE(SUM(view_CustomerProfile[LT_WinLoss])),"bo",CALCULATE(SUM(view_CustomerProfile[LT_Bonus])),"vb",CALCULATE(SUM(view_CustomerProfile[LT_EffectiveBet]))), view_CustomerProfile[RegTime_utc8]>=s, view_CustomerProfile[RegTime_utc8]<e, TREATAS({"Nova88","Goal123","Bwing"},view_CustomerProfile[SiteName]))), "k",[k],"si",view_CustomerProfile[SiteName],"cu",view_CustomerProfile[CurrencyId],"v",view_CustomerProfile[VipLevel],"nru",[nru],"fdu",[fdu],"fd7",[fd7],"dep",[dep],"nd",[nd],"wl",[wl],"bo",[bo],"vb",[vb],"pad",REPT("x",150))
