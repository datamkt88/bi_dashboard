DEFINE VAR M = UNION(DATATABLE("ym",STRING,"s",DATETIME,"e",DATETIME,{{"2026-09",dt"2026-09-01",dt"2026-10-01"},{"2026-10",dt"2026-10-01",dt"2026-11-01"}}), SELECTCOLUMNS(CALENDAR(dt"2026-10-01",dt"2026-10-29"),"ym",FORMAT([Date],"yyyy-mm-dd"),"s",[Date],"e",[Date]+1))
EVALUATE SELECTCOLUMNS(GENERATE(M, VAR s=[s] VAR e=[e] RETURN CALCULATETABLE(ADDCOLUMNS(SUMMARIZE('WS_BIReport FullSummaryDailyMonthly_Output','WS_Customer customer'[SiteName],'WS_Customer customer'[Currency],'WS_Customer customer'[CurrencyId]), "MktNRU", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[NRU_Flag])), "MktFDU", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[FDU_Flag])), "MktDep", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[DepositAmount])), "MktGGR", CALCULATE(-SUM('WS_BIReport FullSummaryDailyMonthly_Output'[WinLostAmount]))), 'WS_BIReport FullSummaryDailyMonthly_Output'[ReportDate]>=s, 'WS_BIReport FullSummaryDailyMonthly_Output'[ReportDate]<e, TREATAS({"Nova88","Goal123","Bwing"}, 'WS_Customer customer'[SiteName]), TREATAS(VALUES('Acquisition Master Channel List'[AffiliateName]), 'WS_Customer customer'[AffiliateName]))), "m",[ym],"Si",'WS_Customer customer'[SiteName],"Cu",'WS_Customer customer'[Currency],"Ci",'WS_Customer customer'[CurrencyId], "MktNRU", [MktNRU], "MktFDU", [MktFDU], "MktDep", [MktDep], "MktGGR", [MktGGR], "pad",REPT("x",400))
