EVALUATE CALCULATETABLE(SELECTCOLUMNS(CustTagSummary, "c", CustTagSummary[CustId], "t", CustTagSummary[TagName]), TREATAS(SELECTCOLUMNS(FILTER(view_CustomerProfile, view_CustomerProfile[SiteName] IN {"Nova88","Goal123","Bwing"} && (view_CustomerProfile[RegTime_utc8]>=dt"2026-07-01" || view_CustomerProfile[LastBettingDate_utc8]>=dt"2026-08-01" || view_CustomerProfile[LastDepositDate_utc8]>=dt"2026-08-01")), "c", view_CustomerProfile[CustId]), CustTagSummary[CustId]))
