DEFINE VAR M = DATATABLE("k",STRING,"s",DATETIME,"e",DATETIME,{{"2025-09",dt"2025-09-01",dt"2025-10-01"},{"2025-10",dt"2025-10-01",dt"2025-11-01"},{"2025-11",dt"2025-11-01",dt"2025-12-01"},{"2025-12",dt"2025-12-01",dt"2026-01-01"},{"2026-01",dt"2026-01-01",dt"2026-02-01"},{"2026-02",dt"2026-02-01",dt"2026-03-01"},{"2026-03",dt"2026-03-01",dt"2026-04-01"},{"2026-04",dt"2026-04-01",dt"2026-05-01"},{"2026-05",dt"2026-05-01",dt"2026-06-01"},{"2026-06",dt"2026-06-01",dt"2026-07-01"},{"2026-07",dt"2026-07-01",dt"2026-08-01"},{"2026-08",dt"2026-08-01",dt"2026-09-01"},{"2026-09",dt"2026-09-01",dt"2026-10-01"},{"2026-10",dt"2026-10-01",dt"2026-11-01"}})
EVALUATE SELECTCOLUMNS(GENERATE(M, VAR s=[s] VAR e=[e] RETURN CALCULATETABLE(ADDCOLUMNS(SUMMARIZE('WS_BIReport FullSummaryDailyMonthly_Output','WS_Customer customer'[SiteName],'WS_Customer customer'[CurrencyId],'WS_Customer customer'[MarketingGroup],'WS_Customer customer'[MarketingChannel],'WS_Customer customer'[MarketingType]), "NRU", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[NRU_Flag])), "FDU", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[FDU_Flag])), "Act", CALCULATE(CALCULATE(DISTINCTCOUNT('WS_BIReport FullSummaryDailyMonthly_Output'[CustId]),'WS_BIReport FullSummaryDailyMonthly_Output'[ActiveUser_Flag]=1)), "Depr", CALCULATE(CALCULATE(DISTINCTCOUNT('WS_BIReport FullSummaryDailyMonthly_Output'[CustId]),'WS_BIReport FullSummaryDailyMonthly_Output'[Depositor_Flag]=1)), "RD", CALCULATE(CALCULATE(DISTINCTCOUNT('WS_BIReport FullSummaryDailyMonthly_Output'[CustId]),'WS_BIReport FullSummaryDailyMonthly_Output'[FDUMonthly_Multi_Redeposit_Flag]=1)), "Dep", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[DepositAmount])), "FD", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[FirstDepositAmt])), "W", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[WithdrawalAmount])), "VB", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[ValidBet])), "WL", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[WinLostAmount])), "BO", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[BonusAmount])), "RB", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[RebateAmount])), "PRO", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[PrizeAmount])+SUM('WS_BIReport FullSummaryDailyMonthly_Output'[OthRewardAmount])+SUM('WS_BIReport FullSummaryDailyMonthly_Output'[ReferralAmount])), "ADJ", CALCULATE(SUM('WS_BIReport FullSummaryDailyMonthly_Output'[AdjustmentAmount]))), 'WS_BIReport FullSummaryDailyMonthly_Output'[ReportDate]>=s, 'WS_BIReport FullSummaryDailyMonthly_Output'[ReportDate]<e, TREATAS({"Nova88","Goal123","Bwing"}, 'WS_Customer customer'[SiteName]))), "k",[k], "d0",'WS_Customer customer'[SiteName], "d1",'WS_Customer customer'[CurrencyId], "d2",'WS_Customer customer'[MarketingGroup], "d3",'WS_Customer customer'[MarketingChannel], "d4",'WS_Customer customer'[MarketingType], "NRU", [NRU], "FDU", [FDU], "Act", [Act], "Depr", [Depr], "RD", [RD], "Dep", [Dep], "FD", [FD], "W", [W], "VB", [VB], "WL", [WL], "BO", [BO], "RB", [RB], "PRO", [PRO], "ADJ", [ADJ])
